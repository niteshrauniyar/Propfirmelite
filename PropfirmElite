        </div>
      </div>

      {/* STATS */}
      <div ref={statsRef} style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit,minmax(150px,1fr))", gap: 14, maxWidth: 860, margin: "0 auto 70px", padding: "0 24px" }}>
        {stats.map((s, i) => <StatCard key={s.label} stat={s} active={statsVisible} />)}
      </div>

      {/* FILTER BAR */}
      <div style={{ maxWidth: 1180, margin: "0 auto", padding: "0 24px 22px", display: "flex", gap: 10, alignItems: "center", flexWrap: "wrap" }}>
        <span style={{ color: "#666", fontSize: 12 }}>Sort by:</span>
        {[["rating","⭐ Top Rated"],["discount","💸 Best Discount"],["split","📈 Highest Split"]].map(([val,label]) => (
          <button key={val} onClick={() => setFilterSort(val)} style={{ background: filterSort===val ? "rgba(0,212,255,0.15)" : "rgba(255,255,255,0.04)", border: `1px solid ${filterSort===val ? "#00D4FF" : "rgba(255,255,255,0.08)"}`, borderRadius: 20, padding: "6px 16px", color: filterSort===val ? "#00D4FF" : "#888", fontSize: 12, cursor: "pointer", fontWeight: filterSort===val ? 700 : 400, transition: "all 0.2s" }}>
            {label}
          </button>
        ))}
        <span style={{ marginLeft: "auto", color: "#555", fontSize: 12 }}>{firms.length} firms listed</span>
      </div>

      {/* CARDS */}
      <div ref={cardsRef} style={{ maxWidth: 1180, margin: "0 auto", padding: "0 24px 70px", display: "grid", gridTemplateColumns: "repeat(auto-fill,minmax(340px,1fr))", gap: 18 }}>
        {sorted.map((firm, i) => <FirmCard key={firm.id} firm={firm} delay={i * 0.08} inView={cardsVisible} />)}
      </div>

      {/* COMPARE MODAL */}
      {showCompare && compareFirms.length > 0 && (
        <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.88)", zIndex: 200, display: "flex", alignItems: "center", justifyContent: "center", padding: 24, animation: "fadeInUp 0.3s ease" }} onClick={() => setShowCompare(false)}>
          <div style={{ background: "#0a0a16", border: "1px solid rgba(0,212,255,0.25)", borderRadius: 24, padding: 32, maxWidth: 860, width: "100%", maxHeight: "80vh", overflowY: "auto" }} onClick={e => e.stopPropagation()}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 24 }}>
              <h2 style={{ margin: 0, fontSize: 20, fontWeight: 800 }}>⚖️ Side-by-Side Comparison</h2>
              <button onClick={() => setShowCompare(false)} style={{ background: "rgba(255,255,255,0.08)", border: "none", borderRadius: 8, padding: "6px 14px", color: "#fff", cursor: "pointer" }}>✕</button>
            </div>
            <div style={{ overflowX: "auto" }}>
              <table style={{ width: "100%", borderCollapse: "collapse" }}>
                <thead>
                  <tr>
                    <td style={{ padding: "10px 14px", color: "#555", fontSize: 11 }}>Feature</td>
                    {compareFirms.map(f => (
                      <td key={f.id} style={{ padding: "10px 14px", textAlign: "center" }}>
                        <div style={{ fontWeight: 800, color: f.color, fontSize: 15 }}>{f.name}</div>
                      </td>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {[["Profit Split","profitSplit"],["Max Funding","maxFunding"],["Challenge","challenge"],["Price","price"],["Rating","rating"]].map(([label,key],i) => (
                    <tr key={key} style={{ background: i%2===0 ? "rgba(255,255,255,0.02)" : "transparent" }}>
                      <td style={{ padding: "12px 14px", color: "#888", fontSize: 12 }}>{label}</td>
                      {compareFirms.map(f => (
                        <td key={f.id} style={{ padding: "12px 14px", textAlign: "center", fontWeight: 700, fontSize: 14 }}>{f[key]}</td>
                      ))}
                    </tr>
                  ))}
                  <tr>
                    <td style={{ padding: "12px 14px", color: "#888", fontSize: 12 }}>Action</td>
                    {compareFirms.map(f => (
                      <td key={f.id} style={{ padding: "12px 14px", textAlign: "center" }}>
                        <a href={f.affiliate} style={{ background: `linear-gradient(90deg,${f.color},${f.color}88)`, borderRadius: 10, padding: "9px 18px", color: "#000", fontWeight: 800, fontSize: 11, textDecoration: "none", display: "inline-block" }}>Choose →</a>
                      </td>
                    ))}
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}

      {/* TESTIMONIALS */}
      <div ref={testiRef} style={{ background: "rgba(0,212,255,0.02)", borderTop: "1px solid rgba(0,212,255,0.07)", borderBottom: "1px solid rgba(0,212,255,0.07)", padding: "70px 24px" }}>
        <div style={{ maxWidth: 1080, margin: "0 auto" }}>
          <h2 style={{ textAlign: "center", fontSize: 26, fontWeight: 800, marginBottom: 6, opacity: testiVisible ? 1 : 0, transition: "opacity 0.8s" }}>Real Traders. Real Results.</h2>
          <p style={{ textAlign: "center", color: "#666", marginBottom: 40, opacity: testiVisible ? 1 : 0, transition: "opacity 0.8s 0.2s" }}>Join 250,000+ funded traders who found their firm here</p>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill,minmax(230px,1fr))", gap: 18 }}>
            {testimonials.map((t, i) => (
              <div key={t.name} style={{ background: "rgba(255,255,255,0.025)", border: "1px solid rgba(255,255,255,0.07)", borderRadius: 16, padding: 20, opacity: testiVisible ? 1 : 0, transform: testiVisible ? "translateY(0)" : "translateY(30px)", transition: `all 0.6s ease ${i * 0.12}s` }}>
                <div style={{ display: "flex", gap: 10, alignItems: "center", marginBottom: 12 }}>
                  <div style={{ width: 38, height: 38, borderRadius: "50%", background: `linear-gradient(135deg,${t.color},${t.color}66)`, display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 800, color: "#000", fontSize: 14 }}>{t.avatar}</div>
                  <div>
                    <div style={{ fontWeight: 700, fontSize: 13 }}>{t.name}</div>
                    <div style={{ fontSize: 11, color: "#666" }}>{t.country}</div>
                  </div>
                </div>
                <p style={{ fontSize: 12, color: "#bbb", lineHeight: 1.65, margin: "0 0 12px" }}>"{t.text}"</p>
                <div style={{ background: "rgba(0,255,136,0.08)", border: "1px solid rgba(0,255,136,0.18)", borderRadius: 8, padding: "5px 10px", fontSize: 11, fontWeight: 700, color: "#00FF88" }}>💰 {t.amount}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* CTA */}
      <div style={{ textAlign: "center", padding: "90px 24px", position: "relative", overflow: "hidden" }}>
        <GlowOrbs />
        <div style={{ position: "relative", zIndex: 2 }}>
          <div style={{ fontSize: 11, color: "#A855F7", fontWeight: 700, marginBottom: 10, letterSpacing: 3 }}>LIMITED TIME OFFER</div>
          <h2 style={{ fontSize: "clamp(26px,4vw,46px)", fontWeight: 900, margin: "0 0 16px" }}>Ready to Trade Firm Capital?</h2>
          <p style={{ color: "#777", marginBottom: 36, fontSize: 15 }}>Use our exclusive discount codes and save on your first challenge today.</p>
          <button style={{ background: "linear-gradient(90deg,#A855F7,#00D4FF,#FF6B35)", backgroundSize: "200%", border: "none", borderRadius: 30, padding: "16px 44px", color: "#000", fontWeight: 800, fontSize: 16, cursor: "pointer", animation: "gradientShift 3s ease infinite, glowPulse 2s infinite" }}>
            Claim Your Discount ⚡
          </button>
        </div>
      </div>

      {/* FOOTER */}
      <footer style={{ borderTop: "1px solid rgba(255,255,255,0.05)", padding: "28px 24px", textAlign: "center" }}>
        <div style={{ fontSize: 18, fontWeight: 900, background: "linear-gradient(90deg,#00D4FF,#A855F7)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", marginBottom: 8 }}>⚡ PropElite</div>
        <p style={{ color: "#444", fontSize: 11, maxWidth: 560, margin: "0 auto 12px", lineHeight: 1.7 }}>This website contains affiliate links. We may earn a commission on purchases. Trading involves significant risk. Always DYOR.</p>
        <div style={{ display: "flex", gap: 16, justifyContent: "center", flexWrap: "wrap" }}>
          {["Privacy Policy","Terms","Disclaimer","Contact"].map(l => (
            <span key={l} style={{ color: "#444", fontSize: 11, cursor: "pointer", transition: "color 0.2s" }} onMouseEnter={e=>e.target.style.color="#888"} onMouseLeave={e=>e.target.style.color="#444"}>{l}</span>
          ))}
        </div>
        <p style={{ color: "#2a2a2a", fontSize: 10, marginTop: 14 }}>© 2026 PropElite Affiliate. All rights reserved.</p>
      </footer>
    </div>
  );
}
